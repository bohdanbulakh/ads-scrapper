# --- Application -------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
PORT=3000

# --- Database ----------------------------------------------------------------
# required. Read by the app and by drizzle-kit.
DATABASE_URL=postgresql://adds_scrapper:change-me-postgres@localhost:5432/adds_scrapper

# --- Redis -------------------------------------------------------------------
# `localhost` on the host, `redis` inside the compose network.
REDIS_HOST=localhost
# Host port published by the redis container (container always listens on 6379).
REDIS_PORT=6379
# required (docker-compose also refuses to start redis without it)
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# --- Logging -----------------------------------------------------------------
# Comma-separated Nest log levels: verbose,debug,log,warn,error,fatal.
LOG_LEVELS=log,warn,error

# --- Queue workers -----------------------------------------------------------
# Jobs one worker runs at a time.
WORKER_CONCURRENCY=10
# How many jobs the dispatchers keep queued ahead of the workers.
QUEUE_TARGET_DEPTH=500

# --- Fake fetch (test data only) ---------------------------------------------
FAKE_FETCH=false
FAKE_FETCH_LATENCY_MS=25
# Share of calls (0..1) that fail transiently, to exercise the queue's retry.
FAKE_FETCH_FAILURE_RATE=0
# How many distinct publisher domains the fake listings hand out.
FAKE_FETCH_PUBLISHER_POOL=50000

# --- Object storage (S3 / MinIO) ---------------------------------------------
# `localhost` on the host, `minio` inside the compose network.
S3_ENDPOINT=http://localhost:9000
# MinIO ignores this, but the AWS SDK requires a region.
S3_REGION=us-east-1
# required. Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below.
S3_ACCESS_KEY=adds_scrapper_minio
S3_SECRET_KEY=change-me-minio
# required. Created automatically by the minio-init compose service.
S3_BUCKET=ads-files
# true for MinIO (host/bucket), false for real AWS S3 (bucket.host).
S3_FORCE_PATH_STYLE=true

# --- docker-compose only -----------------------------------------------------
# Consumed by the postgres container and the published host port. Must match DATABASE_URL above.
POSTGRES_PORT=5432
POSTGRES_USER=adds_scrapper
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=adds_scrapper

# Host ports for the minio S3 API and the built-in MinIO Console (the S3
# browser UI — sign in with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Must match S3_ACCESS_KEY / S3_SECRET_KEY above.
MINIO_ROOT_USER=adds_scrapper_minio
MINIO_ROOT_PASSWORD=change-me-minio

# Bull Board — web dashboard for the BullMQ queues. Host port only; the
# container always listens on 3000 and reads redis over the compose network.
BULL_BOARD_PORT=3001
# Optional basic auth for the dashboard. Leave both empty to skip the login page.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
