# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values before running the stack:
#
#   cp .env.example .env
#   docker compose up -d
#
# Docker Compose automatically loads the root `.env` file, so the values below
# are used both for interpolation inside docker-compose.yml (host port mappings,
# the redis `--requirepass` flag) and are passed into the containers via
# `env_file`.
#
# The app's own variables are validated with Joi at startup
# (src/common/config/env.validation.ts) — it refuses to boot on a bad value.
# Variables marked "required" have no default.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
PORT=3000

# --- Database ----------------------------------------------------------------
# required. Read by the app and by drizzle-kit. Host/port are what the *app*
# connects to: `localhost` when it runs on the host (yarn start:dev), or
# `postgres` when it runs inside the compose network. Must match the
# POSTGRES_* values at the bottom of this file, which configure the container.
DATABASE_URL=postgresql://adds_scrapper:change-me-postgres@localhost:5432/adds_scrapper

# --- Redis -------------------------------------------------------------------
# `localhost` on the host, `redis` inside the compose network.
REDIS_HOST=localhost
# Host port published by the redis container (container always listens on 6379).
REDIS_PORT=6379
# required (docker-compose also refuses to start redis without it)
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# --- docker-compose only -----------------------------------------------------
# Consumed by the postgres container and the published host port, not by the
# app. Must match DATABASE_URL above.
POSTGRES_PORT=5432
POSTGRES_USER=adds_scrapper
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=adds_scrapper
