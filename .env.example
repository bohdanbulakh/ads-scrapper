# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values before running the stack:
#
#   cp .env.example .env
#   docker compose up -d
#
# Docker Compose automatically loads the root `.env` file, so the values below
# are used both for interpolation inside docker-compose.yml (host port mappings,
# the redis `--requirepass` flag) and are passed into the containers via
# `env_file`.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- PostgreSQL --------------------------------------------------------------
# POSTGRES_HOST is what the *app* connects to:
#   - `localhost` when the app runs on the host (yarn start:dev)
#   - `postgres`  when the app runs inside the compose network
POSTGRES_HOST=localhost
# Host port published by the postgres container (container always listens on 5432).
POSTGRES_PORT=5432
POSTGRES_USER=adds_scrapper
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=adds_scrapper

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
# Host port published by the redis container (container always listens on 6379).
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0
